# Supabase (web pública y funciones de Vercel)
VITE_SUPABASE_URL="https://TU-PROYECTO.supabase.co"
VITE_SUPABASE_ANON_KEY="TU_CLAVE_ANON"

# SOLO servidor (Vercel > Settings > Environment Variables). Nunca con prefijo VITE_.
# La usa api/send-email.ts para leer la configuración SMTP sin exponerla al navegador.
SUPABASE_SERVICE_ROLE_KEY="TU_CLAVE_SERVICE_ROLE"

# Opcional: funciones de IA (Gemini)
GEMINI_API_KEY="TU_CLAVE_GEMINI"
